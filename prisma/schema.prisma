generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 剧集智能创编工坊 (DRAMA STUDIO) 数据模型
// 设计原则：
// 1. 题材/模型配置随项目快照存储（schema 演进不受题材库改动影响）
// 2. StoryBeat / TimelineClip 级联删除，归属唯一项目
// 3. 状态字段使用字符串枚举，集中定义在 src/lib/drama.ts，
//    新增状态只改一处；为视频生成任务 (VideoJob) 预留 status/mediaUrl
// 4. schemaVersion 记录工程结构版本，便于后续迁移
// ============================================================

model Project {
  id              String   @id @default(cuid())
  title           String
  status          String   @default("draft") // draft | beatsReady | inProduction | archived
  schemaVersion   String   @default("1.2.0")

  // —— 题材快照 ——
  genreId         String
  genreName       String
  genreBadge      String
  hookTactic      String
  musicMood       String
  tonePrompt      String

  // —— 工程参数 ——
  aspectRatio     String   @default("9:16")
  synopsis        String
  videoModel      String   @default("Omni 1.2 Flash")
  durationSeconds Int      @default(5)
  resolution      String   @default("720p")
  thinkingLevel   String   @default("low") // low | medium | high
  promptEnhance   Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  beats           StoryBeat[]
  clips           TimelineClip[]

  @@index([updatedAt])
  @@map("projects")
}

model StoryBeat {
  id                String  @id @default(cuid())
  projectId         String
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  index             Int
  actTitle          String
  narrativeFunction String // hook | climax | cliffhanger
  pacingNote        String
  description       String
  dialogueSubtitle  String
  cameraMovement    String
  promptGuidance    String

  @@unique([projectId, index])
  @@map("story_beats")
}

model TimelineClip {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  beatIndex  Int // 关联第几幕 (storyBeats.index)
  order      Int // 时间轨顺序（0 起始，重排序时整体重写）
  name       String
  subtitle   String
  format     String   @default("mp4")
  status     String   @default("pending") // pending | generating | ready | failed
  mediaUrl   String? // 视频模型接入后存放产物地址；当前允许手动粘贴外部成片链接
  durationMs Int?

  // —— 分镜拆解扩展（AI 将一幕拆为多镜头时写入；手动片段为空） ——
  shotSize       String? // 景别：远景/全景/中景/近景/特写/大特写
  cameraMovement String? // 运镜（CAMERA_MOVEMENTS 键名）
  visualDesc     String? // 镜头画面内容描述
  plannedMs      Int? // 计划时长（毫秒）

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, order])
  @@map("timeline_clips")
}
